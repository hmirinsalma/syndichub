# EditorConfig pour SyndicHub
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,slnx}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_style = space
indent_size = 2
