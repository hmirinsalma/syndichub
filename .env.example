# ==================================================
# SyndicHub - Variables d'environnement (EXEMPLE)
# ==================================================
# Copier ce fichier en .env.local et remplir avec vos valeurs

# ==================================================
# Base de données
# ==================================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=SyndicHubDB
DB_USER=sa
DB_PASSWORD=VotreMotDePasseSecurise123!

# Chaîne de connexion SQL Server
CONNECTION_STRING=Server=${DB_HOST},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;

# ==================================================
# JWT (Authentification)
# ==================================================
JWT_SECRET=VotreCleSecrete256BitsMinimumPourJWT
JWT_ISSUER=SyndicHub
JWT_AUDIENCE=SyndicHubApp
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ==================================================
# SMTP (Envoi d'emails)
# ==================================================
# En développement : utiliser MailHog ou Mailpit (voir docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@syndichub.local
SMTP_FROM_NAME=SyndicHub

# En production : utiliser un service SMTP réel
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASSWORD=votre-mot-de-passe-application
# SMTP_FROM_EMAIL=noreply@syndichub.com
# SMTP_FROM_NAME=SyndicHub

# ==================================================
# Stockage de fichiers
# ==================================================
FILE_STORAGE_PATH=./storage/uploads
FILE_MAX_SIZE_MB=5

# ==================================================
# Frontend
# ==================================================
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ==================================================
# Hangfire (Tâches planifiées)
# ==================================================
HANGFIRE_DASHBOARD_ENABLED=true
HANGFIRE_DASHBOARD_PATH=/hangfire

# ==================================================
# Logging
# ==================================================
LOG_LEVEL=Information
# Options: Trace, Debug, Information, Warning, Error, Critical

# ==================================================
# CORS (Origines autorisées)
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================================================
# Environnement
# ==================================================
ASPNETCORE_ENVIRONMENT=Development
# Options: Development, Staging, Production
